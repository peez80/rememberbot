# ==============================================================================
# RememberBot - Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# All variables have sensible defaults. Unset variables will use default values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage & Persistence
# ------------------------------------------------------------------------------
# Base directory for persistent user data, chats, uploads and configurations
DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# 2. User Authentication & Backend Provider
# ------------------------------------------------------------------------------
# Active user backend for credentials verification.
# Currently supported: "json" (or "file") for data/config/users.json
USER_BACKEND=json

# Optional custom path to users.json file.
# If unset, defaults to ${DATA_DIR}/config/users.json
# USERS_FILE_PATH=/app/data/config/users.json

# ------------------------------------------------------------------------------
# 3. Session & Cookie Security
# ------------------------------------------------------------------------------
# Name of the HTTP session cookie
SESSION_COOKIE_NAME=session_token

# Session lifetime in seconds (default: 30 days = 2592000)
SESSION_MAX_AGE_SECONDS=2592000

# Require HTTPS for session cookies (true / false)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. Rate Limiting & Brute-Force Defense
# ------------------------------------------------------------------------------
# Maximum failed login attempts allowed before temporary IP/User lock
MAX_LOGIN_ATTEMPTS=5

# Sliding rate-limiting window in seconds
LOGIN_RATE_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 5. Upload & Storage Limits
# ------------------------------------------------------------------------------
# Maximum files attached per chat turn
MAX_UPLOADS_PER_MESSAGE=10

# Maximum single file upload size in bytes (default: 25 MB = 26214400)
MAX_UPLOAD_FILE_SIZE=26214400

# Maximum session ZIP import archive size in bytes (default: 500 MB = 524288000)
MAX_ZIP_UPLOAD_SIZE=524288000

# Maximum number of files inside imported ZIP archives (Zip-Bomb defense)
MAX_ZIP_FILES_COUNT=1000

# Maximum uncompressed bytes extracted from ZIP archives (default: 1000 MB = 1048576000)
MAX_ZIP_UNCOMPRESSED_BYTES=1048576000

# Maximum width / height for cached web thumbnails in pixels
THUMBNAIL_MAX_DIMENSION=400

# ------------------------------------------------------------------------------
# 6. AI & CLI (antigravity-cli / agy) Configuration
# ------------------------------------------------------------------------------
# Path or executable name for antigravity CLI
AGY_EXECUTABLE_PATH=agy

# Path to local conversations database directory
# AGY_CONVERSATIONS_DIR=/root/.gemini/antigravity-cli/conversations

# Global default model passed to agy CLI
# Supported: gemini-3.8-flash, gemini-3.7-flash, gemini-3.1-pro, claude-sonnet-4-6, claude-opus-4-6-thinking, gpt-oss-120b-medium
AGY_DEFAULT_MODEL=gemini-3.8-flash

# Default reasoning effort for models supporting thinking (low, medium, high)
AGY_DEFAULT_THINKING_EFFORT=medium

# Timeout in seconds for background session avatar generation
ICON_GENERATION_TIMEOUT_SECONDS=180.0

# ------------------------------------------------------------------------------
# 7. Logging & Networking
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log output format: text (human readable) or json (structured NDJSON for log aggregators)
LOG_FORMAT=text

# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
